{
  "name": "tasmeer-multi",
  "productName": "Tasmeer Multi",
  "version": "1.0.0",
  "description": "One window over your Claude Code, Codex and Gemini chats: any account answers any chat.",
  "main": "src/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TasmeerJamali/tasmeer-multi.git"
  },
  "homepage": "https://github.com/TasmeerJamali/tasmeer-multi#readme",
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "antigravity",
    "electron",
    "desktop"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.tasmeer-multi",
    "productName": "Tasmeer Multi",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
